# ---- LLM via OpenRouter (required) ----
# Empty means keyless: LLM endpoints answer a typed 503 and embedder 'auto' resolves
# to hashing. A placeholder VALUE here once made CI believe it had a key (2026-08-03):
# /fit resolved 'auto' to openrouter and answered 500. Examples document variables;
# they never fake capabilities.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick model IDs by task from https://openrouter.ai/models
LLM_MODEL_REASONING=REPLACE_WITH_OPENROUTER_MODEL_ID
LLM_MODEL_EXTRACTION=REPLACE_WITH_OPENROUTER_MODEL_ID
LLM_MODEL_JUDGE=REPLACE_WITH_OPENROUTER_MODEL_ID
EMBEDDING_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- Runtime ----
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SMOKE_TEST_TOKEN=dev-smoke-token

# ---- Data (required) ----
DATABASE_URL=postgresql+psycopg://aignite:aignite@localhost:5432/career_compiler
REDIS_URL=redis://localhost:6379/0
EXPECTED_TABLE_COUNT=11

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=career_compiler

# Entailment gate model
# Optional fully-private mode: point at a local OpenAI-compatible model
LOCAL_LLM_BASE_URL=https://example.invalid
# Object storage for uploaded resumes (MinIO in compose)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=aignite
S3_SECRET_KEY=aignite-secret
S3_BUCKET=career-compiler
# The entailment gate: pinned by revision digest (DECISIONS.md 001). These MUST
# match the checkpoint the Dockerfile bakes, or the gate refuses to run.
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
NLI_MODEL_REVISION=6f5cf0a2b59cabb106aca4c287eed12e357e90eb
